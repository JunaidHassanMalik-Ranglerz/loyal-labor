APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_MODE=LIVE #LIVE or DEMO

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wsus_global
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

GOOGLE_MAPS_KEY=
FIREBASE_CREDENTIALS=

# ---------------------------------------------------------------------------
# PayFast Pakistan (Premier PayFast) — SANDBOX ONLY for now
# Docs: https://gopayfast.com/docs
# Portal: https://getstarted.apps.net.pk/login
# Never commit real credentials. Do not enable live without explicit approval.
# ---------------------------------------------------------------------------
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_NAME=LoyLabor
PAYFAST_SECURED_KEY=
PAYFAST_GRANT_TYPE=client_credentials
PAYFAST_CURRENCY=PKR
PAYFAST_SANDBOX_TOKEN_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_SANDBOX_CHECKOUT_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_SANDBOX_API_BASE_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction
PAYFAST_SUCCESS_PATH=/api/payments/payfast/return/success
PAYFAST_FAILURE_PATH=/api/payments/payfast/return/failure
PAYFAST_IPN_PATH=/api/payments/payfast/return/callback
PAYFAST_APP_SUCCESS_DEEP_LINK=loylabor://payfast?status=success
PAYFAST_APP_FAILURE_DEEP_LINK=loylabor://payfast?status=failure
PAYFAST_PUBLIC_BASE_URL=https://your-domain.example/homeservices


# Mobile social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

DEFAULT_SCHEMA_STRING_LENGTH=255
DEFAULT_THEME=1
